{
  "rules": {
    "today": {
      ".read": "auth != null",
      "presence": {
        "$k": {
          ".write": "auth != null",
          ".validate": "$k.length <= 80 && newData.hasChildren(['name', 'at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "icon": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "host": {
            ".validate": "newData.isBoolean()"
          },
          "app": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "room": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "conns": {
        "$dev": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && $dev.length <= 40"
        }
      },
      "roomList": {
        "$rid": {
          ".write": "auth != null",
          ".validate": "$rid.length <= 40 && newData.hasChild('name')",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "priv": {
            ".validate": "newData.isBoolean()"
          },
          "pw": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "seen": {
            ".validate": "newData.isNumber()"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "mem": {
            ".validate": "newData.isString() && newData.val().length <= 400"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rooms": {
        "$rid": {
          ".write": "auth != null && ($rid !== '_none')",
          ".validate": "$rid.length <= 40",
          "session": {},
          "lobby": {},
          "host": {},
          "normalLive": {},
          "potgWait": {},
          "potgRec": {},
          "bridge": {},
          "members": {
            "$k": {
              ".validate": "$k.length <= 80 && newData.hasChildren(['name', 'at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "tag": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "icon": {
                ".validate": "newData.isNumber()"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "host": {
                ".validate": "newData.isBoolean()"
              },
              "app": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "room": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "bridge": {
        "gamePhase": {
          ".write": "auth != null"
        },
        "inGame": {
          ".write": "auth != null"
        },
        "champSelect": {
          ".write": "auth != null"
        },
        "lastChampPicks": {
          ".write": "auth != null"
        },
        "eogStats": {
          ".write": "auth != null"
        },
        "connected": {
          ".write": "auth != null"
        },
        "operators": {
          "$id": {
            ".write": "auth != null"
          }
        }
      },
      "potg": {
        "raw": {
          "$day": {
            ".write": "auth != null && (!newData.exists())",
            "$gid": {
              "$k": {
                ".write": "auth != null"
              }
            }
          }
        }
      },
      "clips": {
        "$day": {
          ".write": "auth != null && (!newData.exists())",
          "$gid": {
            ".write": "auth != null",
            "meta": {},
            "c": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 800000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "accounts": {
        "$puuid": {
          ".write": "auth != null && (newData.exists())",
          ".validate": "$puuid.length <= 80",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "icon": {
            ".validate": "newData.isNumber()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "augGuide": {
        "champs": {
          "$id": {
            ".write": "auth != null"
          }
        },
        "hist": {
          "$id": {
            "$k": {
              ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('at').val() < now - 259200000))"
            }
          }
        },
        "recent": {
          "$k": {
            ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('at').val() < now - 259200000))"
          }
        }
      },
      "days": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$kind": {
            ".validate": "$kind === 'matches' || $kind === 'normals'",
            "$gid": {
              ".write": "auth != null && (!data.exists() && newData.exists() && newData.child('sv').val() === now)",
              "potg": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              },
              "potgRec": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              },
              "guess": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              },
              "mvp": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              },
              "svp": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              },
              "manner": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              },
              "votes": {
                ".write": "auth != null && (data.parent().child('sv').val() > now - 21600000)"
              }
            },
            ".indexOn": [
              "roomName"
            ]
          }
        }
      },
      "config": {
        ".write": false
      },
      "ratings": {
        "$puuid": {
          ".write": "auth != null && $puuid.length <= 80",
          ".validate": "newData.hasChildren(['at'])",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "solo": {
            "tier": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "div": {
              ".validate": "newData.isString() && newData.val().length <= 4"
            },
            "lp": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "l": {
              ".validate": "newData.isNumber()"
            },
            "q": {
              ".validate": "newData.isString() && newData.val().length <= 5"
            },
            "$other": {
              ".validate": false
            }
          },
          "aram": {
            "s": {
              ".validate": "newData.isNumber()"
            },
            "gr": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "wr": {
              ".validate": "newData.isNumber()"
            },
            "kda": {
              ".validate": "newData.isNumber()"
            },
            "pl": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "mayhem": {
            "s": {
              ".validate": "newData.isNumber()"
            },
            "gr": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "wr": {
              ".validate": "newData.isNumber()"
            },
            "kda": {
              ".validate": "newData.isNumber()"
            },
            "pl": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "custom": {
            "s": {
              ".validate": "newData.isNumber()"
            },
            "gr": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "wr": {
              ".validate": "newData.isNumber()"
            },
            "kda": {
              ".validate": "newData.isNumber()"
            },
            "pl": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "src": {
            "list": {
              ".validate": "newData.isNumber()"
            },
            "aram": {
              ".validate": "newData.isNumber()"
            },
            "mayhem": {
              ".validate": "newData.isNumber()"
            },
            "ranked": {
              ".validate": "newData.isBoolean()"
            },
            "custom": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
