{
  "rules": {
    "today": {
      "presence": {
        "$k": {
          ".write": "auth != null && (auth.uid === $k || $k.beginsWith('g_'))",
          ".validate": "$k.length <= 80 && newData.hasChildren(['name', 'at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "icon": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "host": {
            ".validate": "newData.isBoolean()"
          },
          "app": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "room": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        },
        ".read": "auth != null"
      },
      "conns": {
        "$dev": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && $dev.length <= 40"
        },
        ".read": "auth != null"
      },
      "roomList": {
        "$rid": {
          ".write": "auth != null && auth.token.riot === true && (!data.exists() || root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists() || (!newData.exists() && (!data.child('seen').exists() || data.child('seen').val() < now - 90000) && (!data.child('at').exists() || data.child('at').val() < now - 90000)))",
          ".validate": "$rid.length <= 40 && newData.hasChild('name')",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "priv": {
            ".validate": "newData.isBoolean()"
          },
          "pw": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "seen": {
            ".validate": "newData.isNumber()"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "mem": {
            ".validate": "newData.isString() && newData.val().length <= 400"
          },
          "$other": {
            ".validate": false
          }
        },
        ".read": "auth != null"
      },
      "rooms": {
        "$rid": {
          ".write": "auth != null && auth.token.riot === true && !newData.exists() && !root.child('today/roomList/' + $rid).exists()",
          ".validate": "$rid.length <= 40",
          "session": {
            ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
          },
          "lobby": {
            "chat": {
              "$k": {
                ".validate": "$k.length <= 80 && newData.hasChildren(['text', 'at'])",
                "text": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
                },
                "at": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                },
                ".write": "auth != null && auth.token.riot === true && auth.uid === $k"
              }
            },
            "ping": {
              "$k": {
                ".write": "auth != null && auth.token.riot === true && auth.uid === $k"
              }
            },
            "cping": {
              "$k": {
                ".write": "auth != null && auth.token.riot === true && auth.uid === $k"
              }
            },
            "$other": {
              ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
            }
          },
          "host": {
            ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
          },
          "normalLive": {
            ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
          },
          "potgWait": {
            ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
          },
          "potgRec": {
            ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
          },
          "bridge": {
            ".write": "auth != null && auth.token.riot === true && root.child('today/rooms/' + $rid + '/uids/' + auth.uid).exists()"
          },
          "members": {
            "$k": {
              ".validate": "$k.length <= 80 && newData.hasChildren(['name', 'at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "tag": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "icon": {
                ".validate": "newData.isNumber()"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "host": {
                ".validate": "newData.isBoolean()"
              },
              "app": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "room": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              },
              ".write": "auth != null && auth.token.riot === true && auth.uid === $k"
            }
          },
          "uids": {
            "$uid": {
              ".validate": "auth.uid === $uid && newData.isString() && newData.val().length <= 80",
              ".write": "auth != null && auth.token.riot === true && auth.uid === $uid && (!newData.exists() || root.child('today/roomList/' + $rid).exists())"
            }
          },
          "dc": {
            "$puuid": {
              ".validate": "$puuid.length <= 80 && newData.hasChildren([\"id\", \"at\"])",
              "id": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{15,21}$/)"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "on": {
                ".validate": "newData.isBoolean()"
              },
              "g": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{15,21}$/)"
              },
              "gn": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "inv": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{2,32}$/)"
              },
              "$other": {
                ".validate": false
              },
              ".write": "auth != null && auth.token.riot === true && auth.uid === $puuid"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        ".read": "auth != null && auth.token.riot === true"
      },
      "bridge": {
        "gamePhase": {
          ".write": "auth != null"
        },
        "inGame": {
          ".write": "auth != null"
        },
        "champSelect": {
          ".write": "auth != null"
        },
        "lastChampPicks": {
          ".write": "auth != null"
        },
        "eogStats": {
          ".write": "auth != null"
        },
        "connected": {
          ".write": "auth != null"
        },
        "operators": {
          "$id": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null"
      },
      "potg": {
        "raw": {
          "$day": {
            ".write": "auth != null && auth.token.riot === true && (!newData.exists())",
            "$gid": {
              "$k": {
                ".write": "auth != null && auth.token.riot === true"
              }
            }
          }
        },
        ".read": "auth != null"
      },
      "clips": {
        "$day": {
          ".write": "auth != null && auth.token.riot === true && (!newData.exists())",
          "$gid": {
            ".write": "auth != null && auth.token.riot === true",
            "meta": {},
            "c": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 800000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        ".read": "auth != null"
      },
      "accounts": {
        "$puuid": {
          ".write": "auth != null && auth.uid === $puuid",
          ".validate": "$puuid.length <= 80",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "icon": {
            ".validate": "newData.isNumber()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        ".read": "auth != null"
      },
      "augGuide": {
        "champs": {
          "$id": {
            ".write": "auth != null && auth.token.riot === true"
          }
        },
        "hist": {
          "$id": {
            "$k": {
              ".write": "auth != null && auth.token.riot === true && (!data.exists() || (!newData.exists() && data.child('at').val() < now - 259200000))"
            }
          }
        },
        "recent": {
          "$k": {
            ".write": "auth != null && auth.token.riot === true && (!data.exists() || (!newData.exists() && data.child('at').val() < now - 259200000))"
          }
        },
        ".read": "auth != null"
      },
      "days": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$kind": {
            ".validate": "$kind === 'matches' || $kind === 'normals'",
            "$gid": {
              ".write": "auth != null && auth.token.riot === true && (!data.exists() && newData.exists() && newData.child('sv').val() === now) && ($kind === 'normals' || (newData.child('roomId').isString() && root.child('today/rooms/' + newData.child('roomId').val() + '/uids/' + auth.uid).exists()))",
              "potg": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              },
              "potgRec": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              },
              "guess": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              },
              "mvp": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              },
              "svp": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              },
              "manner": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              },
              "votes": {
                ".write": "auth != null && auth.token.riot === true && (data.parent().child('sv').val() > now - 21600000)"
              }
            },
            ".indexOn": [
              "roomName"
            ]
          }
        },
        ".read": "auth != null"
      },
      "config": {
        ".write": false,
        "connCap": {
          ".read": "auth != null"
        },
        "clipProxy": {
          ".read": "auth != null"
        },
        "discordApp": {
          ".read": "auth != null"
        }
      },
      "discord": {
        "$puuid": {
          ".write": "auth != null && auth.uid === $puuid",
          ".validate": "newData.hasChildren(['id', 'at'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{15,21}$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "on": {
            ".validate": "newData.isBoolean()"
          },
          "g": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{15,21}$/)"
          },
          "gn": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "inv": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{2,32}$/)"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.uid === $puuid"
        }
      },
      "ratings": {
        "$puuid": {
          ".write": "auth != null && auth.uid === $puuid",
          ".validate": "newData.hasChildren(['at'])",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "solo": {
            "tier": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "div": {
              ".validate": "newData.isString() && newData.val().length <= 4"
            },
            "lp": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "l": {
              ".validate": "newData.isNumber()"
            },
            "q": {
              ".validate": "newData.isString() && newData.val().length <= 5"
            },
            "$other": {
              ".validate": false
            }
          },
          "aram": {
            "s": {
              ".validate": "newData.isNumber()"
            },
            "gr": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "wr": {
              ".validate": "newData.isNumber()"
            },
            "kda": {
              ".validate": "newData.isNumber()"
            },
            "pl": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "mayhem": {
            "s": {
              ".validate": "newData.isNumber()"
            },
            "gr": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "wr": {
              ".validate": "newData.isNumber()"
            },
            "kda": {
              ".validate": "newData.isNumber()"
            },
            "pl": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "custom": {
            "s": {
              ".validate": "newData.isNumber()"
            },
            "gr": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "w": {
              ".validate": "newData.isNumber()"
            },
            "wr": {
              ".validate": "newData.isNumber()"
            },
            "kda": {
              ".validate": "newData.isNumber()"
            },
            "pl": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "src": {
            "list": {
              ".validate": "newData.isNumber()"
            },
            "aram": {
              ".validate": "newData.isNumber()"
            },
            "mayhem": {
              ".validate": "newData.isNumber()"
            },
            "ranked": {
              ".validate": "newData.isBoolean()"
            },
            "custom": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        ".read": "auth != null"
      },
      "owners": {
        "$puuid": {
          ".validate": "$puuid.length <= 80",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.uid === $puuid",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
