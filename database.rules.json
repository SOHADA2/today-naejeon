{
  "rules": {
    "today": {
      ".read": true,
      "presence": {
        "$k": {
          ".write": true,
          ".validate": "$k.length <= 80 && newData.hasChildren(['name', 'at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "icon": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "host": {
            ".validate": "newData.isBoolean()"
          },
          "app": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "room": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "conns": {
        "$dev": {
          ".write": true,
          ".validate": "newData.isNumber() && $dev.length <= 40"
        }
      },
      "roomList": {
        "$rid": {
          ".write": true,
          ".validate": "$rid.length <= 40 && newData.hasChild('name')",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "priv": {
            ".validate": "newData.isBoolean()"
          },
          "pw": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "host": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "seen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rooms": {
        "$rid": {
          ".write": "$rid !== '_none'",
          ".validate": "$rid.length <= 40",
          "session": {},
          "lobby": {},
          "host": {},
          "normalLive": {},
          "potgWait": {},
          "potgRec": {},
          "bridge": {},
          "$other": {
            ".validate": false
          }
        }
      },
      "bridge": {
        "gamePhase": {
          ".write": true
        },
        "inGame": {
          ".write": true
        },
        "champSelect": {
          ".write": true
        },
        "lastChampPicks": {
          ".write": true
        },
        "eogStats": {
          ".write": true
        },
        "connected": {
          ".write": true
        },
        "operators": {
          "$id": {
            ".write": true
          }
        }
      },
      "potg": {
        "raw": {
          "$day": {
            ".write": "!newData.exists()",
            "$gid": {
              "$k": {
                ".write": true
              }
            }
          }
        }
      },
      "clips": {
        "$day": {
          ".write": "!newData.exists()",
          "$gid": {
            ".write": true,
            "meta": {},
            "c": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 800000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "accounts": {
        "$puuid": {
          ".write": "newData.exists()",
          ".validate": "$puuid.length <= 80",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "icon": {
            ".validate": "newData.isNumber()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "augGuide": {
        "champs": {
          "$id": {
            ".write": true
          }
        },
        "hist": {
          "$id": {
            "$k": {
              ".write": "!data.exists() || (!newData.exists() && data.child('at').val() < now - 259200000)"
            }
          }
        },
        "recent": {
          "$k": {
            ".write": "!data.exists() || (!newData.exists() && data.child('at').val() < now - 259200000)"
          }
        }
      },
      "days": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$kind": {
            ".validate": "$kind === 'matches' || $kind === 'normals'",
            "$gid": {
              ".write": "!data.exists() && newData.exists() && newData.child('sv').val() === now",
              "potg": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              },
              "potgRec": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              },
              "guess": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              },
              "mvp": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              },
              "svp": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              },
              "manner": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              },
              "votes": {
                ".write": "data.parent().child('sv').val() > now - 21600000"
              }
            }
          }
        }
      },
      "config": {
        ".write": false
      }
    }
  }
}
